{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": "./src",
        "incremental": false,
        "skipLibCheck": true,
        "lib": ["ES2023"],
        "noUnusedLocals": false,
        "importHelpers": false,
        "declaration": false,
        "declarationMap": false
    },
    "include": ["./src/**/*"]
}
